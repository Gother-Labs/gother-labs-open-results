{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gotherlabs.com/schemas/result.schema.json",
  "title": "Göther Labs Result",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "title",
    "domain",
    "status",
    "published_at",
    "summary",
    "problem_statement",
    "evaluation_contract",
    "metrics",
    "artifacts",
    "website"
  ],
  "properties": {
    "schema_version": {
      "const": "result/v1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "problem_statement": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_contract": {
      "type": "object",
      "required": [
        "summary",
        "artifact"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifactPath"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "seed",
        "best",
        "improvement",
        "units",
        "validation_status"
      ],
      "properties": {
        "seed": {
          "type": "number"
        },
        "best": {
          "type": "number"
        },
        "improvement": {
          "type": "number"
        },
        "improvement_pct": {
          "type": "number"
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "lower_is_better",
            "higher_is_better"
          ]
        },
        "validation_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "metrics",
        "provenance"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/artifactPath"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/artifactPath"
            }
          }
        ]
      }
    },
    "website": {
      "type": "object",
      "required": [
        "order",
        "card_label",
        "card_summary",
        "detail_path"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "featured": {
          "type": "boolean"
        },
        "card_label": {
          "type": "string",
          "minLength": 1
        },
        "card_summary": {
          "type": "string",
          "minLength": 1
        },
        "card_visual": {
          "type": "string",
          "minLength": 1
        },
        "card_metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "detail_path": {
          "$ref": "#/$defs/websitePath"
        },
        "surface_path": {
          "$ref": "#/$defs/websitePath"
        },
        "display_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "figure_captions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "score_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifactPath": {
      "type": "string",
      "minLength": 1
    },
    "websitePath": {
      "type": "string",
      "pattern": "^results/[a-z0-9]+(?:-[a-z0-9]+)*/(?:[a-z0-9._-]+/)*$"
    }
  },
  "additionalProperties": false
}
